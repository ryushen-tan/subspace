# Backend environment variables
# Copy this file to .env and fill in real values

# OpenRouter (used by backend for LLM calls)
openrouter_api_key=YOUR_OPENROUTER_API_KEY
openrouter_model=google/gemini-2.0-flash-thinking-exp:free
openrouter_include_reasoning=false
openrouter_reasoning_effort=medium # low, medium, high

# ElevenLabs (used for TTS)
VITE_ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY

# PocketBase URL (set to local or prod per environment)
POCKETBASE_URL=http://127.0.0.1:8090
